# Solo para dev, stage y prod: el pipeline escribe este archivo desde los GitHub Environments.
# compose.local.yaml no lo necesita.

# Entorno: dev | stage | prod. Nombra el proyecto compose y la red puentes-<APP_ENV> que comparte con el backend.
APP_ENV=dev
# Imagen publicada en Docker Hub
DOCKERHUB_USERNAME=
IMAGE_TAG=
# Puerto del host donde nginx atiende: dev 8082, stage 8081, prod 80
HTTP_PORT=8082
